{
  "rules": {
    ".read": false,
    ".write": false,
    "otp": {
      "$hash": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'sms-gateway@loooans.com'"
      }
    },
    "gateway_status": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'sms-gateway@loooans.com'"
      }
    }
  }
}
